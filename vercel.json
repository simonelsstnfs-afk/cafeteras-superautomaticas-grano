{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "s-maxage=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/fichas/(.*)",
      "dest": "/fichas/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
